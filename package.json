{
  "name": "@rvanbaalen/eslint-config",
  "type": "module",
  "version": "2.0.2",
  "description": "A reasonable, reusable default config for eslint v9 based on antfu/eslint-config",
  "author": "Robin van Baalen",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslintconfig",
    "config",
    "javascript",
    "styleguide",
    "format",
    "lint"
  ],
  "main": "index.js",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvanbaalen/eslint-config.git"
  },
  "scripts": {
    "lint": "eslint .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@antfu/eslint-config": "^7.7.0",
    "eslint": "^10.0.3",
    "eslint-plugin-format": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "vite": "^7.3.1"
  }
}
